<Window x:Class="VocaLink.Desktop.InteractionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VocaLink"
        Width="320"
        Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="FrostedLanguageItemStyle"
               TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Foreground" Value="#F7FCFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#5B527A99" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#A03D789D" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FrostedLanguageComboStyle"
               TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="#F7FCFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource FrostedLanguageItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="GlassBorder"
                                    Background="#B8233852"
                                    BorderBrush="#9AC8E1"
                                    BorderThickness="1"
                                    CornerRadius="10" />
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="11,0,36,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Path Width="9"
                                  Height="5"
                                  Margin="0,0,13,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Fill="#F7FCFF"
                                  Stretch="Fill"
                                  Data="M 0 0 L 4.5 5 L 9 0 Z" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,5,0,0"
                                        Padding="4"
                                        Background="#F21A2A40"
                                        BorderBrush="#86B9D5"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <ScrollViewer MaxHeight="190"
                                                  SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlassBorder"
                                        Property="Background"
                                        Value="#D02E4B68" />
                                <Setter TargetName="GlassBorder"
                                        Property="BorderBrush"
                                        Value="#BDEBFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="GlassBorder"
                                        Property="BorderBrush"
                                        Value="#58D7FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GlassBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F0182438"
            BorderBrush="#4B7795"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="14,0,8,0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBlock x:Name="TitleText"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <Button x:Name="ChatModeButton"
                            HorizontalAlignment="Left"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Visibility="Collapsed"
                            Click="ChatModeButton_Click" />
                </Grid>
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Width="28"
                        Height="26"
                        Padding="0"
                        Background="#6E3140"
                        Content="×"
                        Click="CloseButton_Click" />
            </Grid>

            <Grid x:Name="ChatPanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="MessageList"
                         Margin="10,0,16,8"
                         ItemsSource="{Binding Messages}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False">
                    <ListBox.Resources>
                        <Style x:Key="ChatScrollThumbStyle"
                               TargetType="{x:Type Thumb}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border Background="#CFE7F7"
                                                CornerRadius="2" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Width" Value="5" />
                            <Setter Property="Opacity" Value="0.16" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Width="5"
                                              Background="Transparent">
                                            <Track x:Name="PART_Track"
                                                   IsDirectionReversed="True">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                  Opacity="0"
                                                                  IsHitTestVisible="False" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource ChatScrollThumbStyle}" />
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                  Opacity="0"
                                                                  IsHitTestVisible="False" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.72" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                            <Setter Property="IsHitTestVisible" Value="True" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,3" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Bubble"
                                    MaxWidth="232"
                                    Padding="9,6"
                                    HorizontalAlignment="Left"
                                    Background="#293B55"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Foreground="#8FDFFF"
                                               FontSize="9"
                                               Text="{Binding Speaker}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="White"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Text="{Binding Text}" />
                                    <Grid Margin="0,3,0,0">
                                        <TextBlock x:Name="OfflineLabel"
                                                   VerticalAlignment="Center"
                                                   Foreground="#FFCA80"
                                                   FontSize="8"
                                                   Text="{Binding OfflineLabel}"
                                                   Visibility="Collapsed" />
                                        <Button x:Name="ReplayButton"
                                                Width="22"
                                                Height="18"
                                                HorizontalAlignment="Right"
                                                Padding="0"
                                                Background="#38536F"
                                                BorderBrush="#7096AF"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                FontSize="9"
                                                Foreground="White"
                                                Content="▶"
                                                ToolTip="Replay"
                                                Visibility="Collapsed"
                                                Click="ReplayMessageButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}"
                                             Value="True">
                                    <Setter TargetName="Bubble"
                                            Property="HorizontalAlignment"
                                            Value="Right" />
                                    <Setter TargetName="Bubble"
                                            Property="Background"
                                            Value="#276785" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOffline}"
                                             Value="True">
                                    <Setter TargetName="OfflineLabel"
                                            Property="Visibility"
                                             Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasAudio}"
                                             Value="True">
                                    <Setter TargetName="ReplayButton"
                                            Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid x:Name="ChatInputPanel"
                      Grid.Row="1"
                      Margin="10,4,10,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageInput"
                             MinHeight="40"
                             MaxHeight="58"
                             Padding="9,6"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Foreground="White"
                             CaretBrush="White"
                             Background="#243148"
                             BorderBrush="#41627E"
                             BorderThickness="1"
                             PreviewKeyDown="MessageInput_PreviewKeyDown" />
                    <Button x:Name="SendButton"
                            Grid.Column="1"
                            Width="58"
                            Height="40"
                            Margin="6,0,0,0"
                            Padding="0"
                            Background="#27759B"
                            Click="SendButton_Click" />
                </Grid>

                <Grid x:Name="VoiceGenerationPanel"
                      Grid.RowSpan="2"
                      Background="#F0182438"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Margin="10,8,10,8"
                            Background="#243148"
                            BorderBrush="#41627E"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <TextBox x:Name="VoiceInput"
                                     Padding="12,10"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Foreground="White"
                                     CaretBrush="White"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     PreviewKeyDown="VoiceInput_PreviewKeyDown" />
                            <TextBlock x:Name="VoiceGenerationDescription"
                                       Margin="12,10"
                                       VerticalAlignment="Top"
                                       IsHitTestVisible="False"
                                       Foreground="#91AEC1"
                                       FontSize="12"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=VoiceInput}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="10,0,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="GenerateVoiceButton"
                                Height="42"
                                Padding="14,0"
                                Background="#27759B"
                                Click="GenerateVoiceButton_Click" />
                        <Button x:Name="OpenVoiceFolderButton"
                                Grid.Column="1"
                                Width="46"
                                Height="42"
                                Margin="7,0,0,0"
                                Padding="0"
                                FontSize="16"
                                Content="📁"
                                Click="OpenVoiceFolderButton_Click" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="SingingPanel"
                  Grid.Row="1"
                  Margin="8,0,8,0"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="9,7"
                        Background="#243148"
                        BorderBrush="#41627E"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="CurrentTrackText"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Row="1" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <Button x:Name="PreviousTrackButton"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        FontSize="13"
                                        Content="⏮"
                                        Click="PreviousTrackButton_Click" />
                                <Button x:Name="PlayPauseButton"
                                        Width="44"
                                        Height="32"
                                        Margin="5,0"
                                        Padding="0"
                                        FontSize="13"
                                        Background="#27759B"
                                        Content="▶"
                                        Click="PlayPauseButton_Click" />
                                <Button x:Name="NextTrackButton"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        FontSize="13"
                                        Content="⏭"
                                        Click="NextTrackButton_Click" />
                            </StackPanel>
                            <Button x:Name="OpenMusicFolderButton"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="32"
                                    Margin="5,0,0,0"
                                    Padding="0"
                                    FontSize="13"
                                    Content="📁"
                                    Click="OpenMusicFolderButton_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Button x:Name="ShowUploadButton"
                        Grid.Row="1"
                        Height="34"
                        Margin="0,5,0,0"
                        Padding="4,0"
                        FontSize="12"
                        Background="#27759B"
                        Click="ShowUploadButton_Click" />
            </Grid>

            <Popup x:Name="CoverPopup"
                   PlacementTarget="{Binding ElementName=ShowUploadButton}"
                   Placement="Right"
                   HorizontalOffset="6"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   PopupAnimation="Fade">
                <Border Width="310"
                        Padding="8"
                        Background="#F0182438"
                        BorderBrush="#4B7795"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel>
                        <Border x:Name="AudioDropZone"
                                MinHeight="58"
                                Padding="8,6"
                                AllowDrop="True"
                                Background="#182337"
                                BorderBrush="#5F829B"
                                BorderThickness="1"
                                CornerRadius="9"
                                DragEnter="AudioDropZone_DragEnter"
                                Drop="AudioDropZone_Drop"
                                MouseLeftButtonUp="AudioDropZone_MouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="SelectedAudioText"
                                               Foreground="#DDF7FF"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="SelectedScoreText"
                                               Margin="0,3,0,0"
                                               Foreground="#8FB6CC"
                                               FontSize="9"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <Button x:Name="ClearUploadButton"
                                        Grid.Column="1"
                                        Width="22"
                                        Height="22"
                                        Margin="6,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Background="#C43A4D"
                                        BorderThickness="0"
                                        Content="×"
                                        Visibility="Collapsed"
                                        Click="ClearUploadButton_Click" />
                            </Grid>
                        </Border>

                        <ProgressBar x:Name="SingingProgressBar"
                                     Height="4"
                                     Margin="0,6,0,0"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="SingingProgressText"
                                   Margin="2,4,2,0"
                                   Foreground="#DDF7FF"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.65*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SongLanguageCombo"
                                      Margin="0,0,5,0"
                                      Style="{StaticResource FrostedLanguageComboStyle}"
                                      SelectedIndex="0"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem x:Name="SongLanguagePlaceholder" Tag="" />
                                <ComboBoxItem x:Name="SongChineseOption" Tag="chinese" />
                                <ComboBoxItem x:Name="SongEnglishOption" Tag="english" />
                                <ComboBoxItem x:Name="SongJapaneseOption" Tag="japanese" />
                            </ComboBox>
                            <Button x:Name="SubmitCoverButton"
                                    Grid.Column="1"
                                    Height="34"
                                    Margin="5,0,0,0"
                                    Padding="4,0"
                                    FontSize="12"
                                    Background="#27759B"
                                    Click="SubmitCoverButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>

            <Grid x:Name="SettingsPanel"
                  Grid.Row="1"
                  Margin="18,10"
                  Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="LanguageLabel"
                               Foreground="White"
                               FontSize="13" />
                    <ComboBox x:Name="LanguageCombo"
                              Margin="0,8,0,12"
                              Height="36"
                              SelectedValuePath="Tag">
                        <ComboBoxItem x:Name="ChineseOption"
                                      Tag="zh-CN" />
                        <ComboBoxItem x:Name="EnglishOption"
                                      Tag="en-US" />
                    </ComboBox>
                    <TextBlock x:Name="TopmostModeLabel"
                               Foreground="White"
                               FontSize="13" />
                    <ComboBox x:Name="TopmostModeCombo"
                              Margin="0,8,0,12"
                              Height="36"
                              SelectedValuePath="Tag">
                        <ComboBoxItem x:Name="TopmostWindowOption"
                                      Tag="window" />
                        <ComboBoxItem x:Name="TopmostAlwaysOption"
                                      Tag="always" />
                        <ComboBoxItem x:Name="TopmostNeverOption"
                                      Tag="never" />
                    </ComboBox>
                    <Button x:Name="SaveSettingsButton"
                            HorizontalAlignment="Left"
                            Background="#27759B"
                            Click="SaveSettingsButton_Click" />
                    <Border x:Name="DeveloperOptionsPanel"
                            Margin="0,14,0,0"
                            Padding="10"
                            Background="#182337"
                            BorderBrush="#41627E"
                            BorderThickness="1"
                            CornerRadius="9"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DeveloperOptionsTitle"
                                       Foreground="#8FDFFF"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="DeveloperOptionsDescription"
                                       Margin="0,4,0,0"
                                       Foreground="#DDF7FF"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Margin="14,0,14,8"
                       Foreground="#8FB6CC"
                       FontSize="9"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
